# Environment variable template for Jira and Confluence Agent
# Copy this file to .env and fill in your actual credentials

# Jira Configuration
JIRA_URL=https://your-company.atlassian.net
JIRA_USERNAME=admin@example.com
JIRA_PASSWORD=your_api_token_here

# Confluence Configuration
CONFLUENCE_URL=https://your-company.atlassian.net
CONFLUENCE_USERNAME=admin@example.com
CONFLUENCE_PASSWORD=your_api_token_here

# Agent Configuration (optional)
AGENT_CONFIG=/app/config/agent_config.yaml
